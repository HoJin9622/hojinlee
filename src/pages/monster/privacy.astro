---
import "@styles/base.css";
import "@fontsource/pretendard/400.css";
import "@fontsource/pretendard/500.css";
import "@fontsource/pretendard/600.css";
import "@fontsource/pretendard/700.css";

const pageTitle = "먼스터(Monster) 개인정보처리방침";
const pageDescription =
  "금융 상품 비교 서비스 먼스터(Monster) 모바일 앱의 공식 개인정보처리방침입니다.";
const effectiveDate = "2026년 3월 20일";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
  </head>
  <body class="bg-[#f8f9fa] text-[#212529] antialiased">
    {/* 독립형 상단 앱 바 */}
    <header class="border-b border-gray-200 bg-white">
      <div
        class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4 sm:px-6"
      >
        <div class="flex items-center gap-2.5">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 text-lg font-bold text-white shadow-sm"
          >
            M
          </span>
          <div>
            <h1 class="text-base leading-tight font-bold text-gray-900">
              먼스터 (Monster)
            </h1>
            <p class="text-xs text-gray-500">모바일 앱 개인정보처리방침</p>
          </div>
        </div>
        <span
          class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700"
        >
          v3.0.0
        </span>
      </div>
    </header>

    {/* 본문 컨테이너 */}
    <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12">
      {/* 문서 헤더 */}
      <div
        class="mb-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8"
      >
        <div
          class="mb-3 inline-block rounded-md bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600"
        >
          공식 규정
        </div>
        <h2 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
          개인정보처리방침
        </h2>
        <p class="mt-2 text-sm text-gray-500">
          <strong>시행일자:</strong>
          {effectiveDate}
        </p>

        {/* 상단 3대 핵심 요약 카드 */}
        <div
          class="mt-6 rounded-xl border border-blue-100 bg-blue-50/60 p-4 sm:p-5"
        >
          <h3
            class="mb-3 flex items-center gap-2 text-sm font-bold text-blue-900"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-blue-700"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
            핵심 요약 안내
          </h3>
          <ul
            class="space-y-2 text-xs leading-relaxed text-blue-950 sm:text-sm"
          >
            <li class="flex items-start gap-2">
              <span class="font-bold text-blue-600">✔</span>
              <span
                ><strong>회원가입 없음:</strong> 성명, 주민등록번호, 연락처, 계좌번호
                등 직접적인 식별정보를 일절 수집하거나 서버에 저장하지 않습니다.</span
              >
            </li>
            <li class="flex items-start gap-2">
              <span class="font-bold text-blue-600">✔</span>
              <span
                ><strong>기기 로컬 저장:</strong> 찜한 상품(망태기) 및 검색 필터는
                이용자의 단말기 내부(AsyncStorage)에만 저장되며 외부 서버로 전송되지
                않습니다.</span
              >
            </li>
            <li class="flex items-start gap-2">
              <span class="font-bold text-blue-600">✔</span>
              <span
                ><strong>비맞춤형 광고 송출:</strong> Google AdMob 배너 광고 송출
                시 사용자의 행동을 추적하는 맞춤형 광고를 요청하지 않으며, <strong
                  >비맞춤형(Non-Personalized) 광고 전용</strong
                >으로 동작합니다.</span
              >
            </li>
          </ul>
        </div>
      </div>

      {/* 법정 필수 조항 카드 */}
      <div
        class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8"
      >
        <article class="space-y-8 text-sm leading-relaxed text-gray-700">
          <p class="text-sm leading-relaxed text-gray-600">
            이호진(이하 "운영자")은 모바일 애플리케이션 <strong
              >'먼스터(Monster)'</strong
            >(이하 "앱" 또는 "서비스")를 이용하는 정보주체의 자유와 권리 보호를
            서약하며, 「개인정보 보호법」 제30조 및 관계 법령, Google Play
            개발자 정책, Apple App Store 심사 지침을 준수하여 다음과 같이
            개인정보처리방침을 수립·공개합니다.
          </p>

          <section class="space-y-2 border-t border-gray-100 pt-6">
            <h3 class="text-base font-bold text-gray-900">
              제1조 (개인정보의 처리 목적)
            </h3>
            <p>
              운영자는 다음의 목적을 위해 최소한의 정보를 처리합니다. 처리하고
              있는 정보는 다음의 목적 이외의 용도로는 이용되지 않으며, 이용
              목적이 변경되는 경우에는 「개인정보 보호법」 제18조에 따라 별도의
              동의를 받는 등 필요한 조치를 이행할 것입니다.
            </p>
            <ol class="list-decimal space-y-1 pl-5 text-gray-600">
              <li>
                <strong>금융 상품 비교 및 편의 서비스 제공:</strong> 은행 및 저축은행의
                예금·적금 금리 정보 조회, 이자 계산, 관심 상품(망태기) 보관 기능 제공
              </li>
              <li>
                <strong>모바일 인앱 광고 송출 및 운영 통계:</strong> 서비스 무료 제공
                유지를 위한 비맞춤형 배너 광고 송출, 광고 게재 빈도 제어(Frequency
                Capping), 부정 클릭 방지 및 노출 성과 측정
              </li>
              <li>
                <strong>서비스 보안 및 안정성 유지:</strong> 비인가 API 접근 차단,
                비정상적 트래픽 방어, 시스템 오류 진단 및 성능 최적화
              </li>
            </ol>
          </section>

          <section class="space-y-3 border-t border-gray-100 pt-6">
            <h3 class="text-base font-bold text-gray-900">
              제2조 (처리하는 개인정보의 항목 및 수집 방법)
            </h3>
            <p>
              앱은 회원가입이나 로그인 절차가 없으므로, 이용자의 성명, 전화번호,
              이메일, 생년월일, 주민등록번호, 계좌번호 등 직접적인 개인 식별
              정보를 일절 수집하거나 당사 서버에 저장하지 않습니다.
            </p>

            <div class="overflow-x-auto rounded-xl border border-gray-200">
              <table class="w-full text-left text-xs sm:text-sm">
                <thead
                  class="border-b border-gray-200 bg-gray-50 font-semibold text-gray-800"
                >
                  <tr>
                    <th class="border-r border-gray-200 p-3">구분</th>
                    <th class="border-r border-gray-200 p-3">처리 항목</th>
                    <th class="border-r border-gray-200 p-3"
                      >수집 및 저장 주체</th
                    >
                    <th class="p-3">처리 목적</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-gray-600">
                  <tr>
                    <td
                      class="border-r border-gray-200 p-3 font-medium text-gray-900"
                      >단말기 로컬 데이터</td
                    >
                    <td class="border-r border-gray-200 p-3"
                      >찜한 상품 ID 목록(망태기), 필터 설정값 (은행, 가입방식,
                      금리유형)</td
                    >
                    <td class="border-r border-gray-200 p-3"
                      >이용자 단말기 내부 저장소<br /><span
                        class="text-xs font-semibold text-blue-600"
                        >(외부 서버 전송 없음)</span
                      ></td
                    >
                    <td class="p-3">앱 내 관심 상품 북마크 및 검색 필터 유지</td
                    >
                  </tr>
                  <tr>
                    <td
                      class="border-r border-gray-200 p-3 font-medium text-gray-900"
                      >광고 및 기기 정보<br /><span
                        class="text-xs text-gray-400">(Google AdMob)</span
                      ></td
                    >
                    <td class="border-r border-gray-200 p-3">
                      기기 모델명, OS 버전, 해상도, IP 주소(대략적 위치 추정용),
                      국가/언어 설정, 광고 반응 기록, 크래시 진단 로그
                    </td>
                    <td class="border-r border-gray-200 p-3"
                      >Google LLC<br /><span class="text-xs text-gray-400"
                        >(Google Mobile Ads SDK)</span
                      ></td
                    >
                    <td class="p-3">
                      비맞춤형 배너 광고 송출, 광고 성과 통계 측정, 부정 클릭
                      방지<br />
                      <span class="text-xs font-semibold text-blue-600"
                        >(*행태 추적 기반의 맞춤형 광고 미사용)</span
                      >
                    </td>
                  </tr>
                  <tr>
                    <td
                      class="border-r border-gray-200 p-3 font-medium text-gray-900"
                      >네트워크 접속 로그<br /><span
                        class="text-xs text-gray-400">(Cloudflare Workers)</span
                      ></td
                    >
                    <td class="border-r border-gray-200 p-3"
                      >접속 IP 주소, 요청 일시, User-Agent, API 호출 URL</td
                    >
                    <td class="border-r border-gray-200 p-3"
                      >Cloudflare, Inc.<br /><span class="text-xs text-gray-400"
                        >(API 호스팅 인프라)</span
                      ></td
                    >
                    <td class="p-3"
                      >API 서버 네트워크 보안, DDoS 공격 방어, 시스템 안정성
                      유지</td
                    >
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <section class="space-y-2 border-t border-gray-100 pt-6">
            <h3 class="text-base font-bold text-gray-900">
              제3조 (개인정보의 처리 및 보유 기간)
            </h3>
            <ol class="list-decimal space-y-1 pl-5 text-gray-600">
              <li>
                <strong>단말기 내부 저장 데이터:</strong> 이용자가 앱을 삭제하거나
                단말기 내 애플리케이션 저장소 데이터를 초기화할 때까지 단말기 내부에서만
                보관되며, 삭제 시 즉시 파기됩니다.
              </li>
              <li>
                <strong>제3자 광고 SDK 정보:</strong> Google AdMob을 통해 처리되는
                비맞춤형 광고 및 기기 관련 데이터는 Google의 데이터 보관 정책 및 개인정보처리방침에
                따릅니다.
              </li>
              <li>
                <strong>서버 접속 로그:</strong> 보안 및 시스템 모니터링을 위해 생성되는
                통상적인 접속 로그는 Cloudflare 표준 보관 정책에 따라 일정 기간 보관
                후 자동 파기됩니다.
              </li>
            </ol>
          </section>

          <section class="space-y-2 border-t border-gray-100 pt-6">
            <h3 class="text-base font-bold text-gray-900">
              제4조 (개인정보의 제3자 제공)
            </h3>
            <p>
              운영자는 정보주체의 개인정보를 원칙적으로 외부에 제공하지
              않습니다. 다만, 서비스 운영 및 무료 제공 유지를 위한 인앱 광고
              송출을 위해 아래와 같이 전문 광고 사업자의 SDK를 연동하고
              있습니다.
            </p>
            <div
              class="space-y-1 rounded-xl border border-gray-200 bg-gray-50 p-4 text-xs text-gray-700 sm:text-sm"
            >
              <p><strong>제공받는 자:</strong> Google LLC (Google AdMob)</p>
              <p>
                <strong>제공 목적:</strong> 모바일 앱 내 비맞춤형(Non-Personalized)
                배너 광고 송출, 광고 성과 및 통계 분석, 부정 이용 방지
              </p>
              <p>
                <strong>제공 항목:</strong> 기기 식별 정보(모델명, OS 버전, 해상도),
                대략적 위치(IP 기반), 광고 노출 및 클릭 로그
              </p>
              <p>
                <strong>보유 및 이용 기간:</strong> Google 개인정보 보호정책 준수
                (<a
                  href="https://policies.google.com/privacy"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-600 underline"
                  >Google 개인정보 보호정책 확인</a
                >)
              </p>
              <p class="font-semibold text-blue-700">
                ※ 특기 사항: 앱은 <code
                  class="rounded bg-gray-200 px-1 py-0.5 text-xs text-gray-800"
                  >requestNonPersonalizedAdsOnly: true</code
                > 모드로 동작하여 개인 맞춤형 타겟팅 광고를 일절 요청하지 않습니다.
              </p>
            </div>
          </section>

          <section class="space-y-2 border-t border-gray-100 pt-6">
            <h3 class="text-base font-bold text-gray-900">
              제5조 (개인정보처리의 위탁)
            </h3>
            <p>
              운영자는 원활한 서버리스 API 호스팅 및 데이터 보호를 위해 다음과
              같이 개인정보 처리 업무를 위탁하고 있습니다.
            </p>
            <ul class="list-disc space-y-1 pl-5 text-gray-600">
              <li><strong>수탁자:</strong> Cloudflare, Inc.</li>
              <li>
                <strong>위탁 업무 내용:</strong> 서버리스 API 인프라 운영(Cloudflare
                Workers), 데이터베이스 호스팅(Cloudflare D1), 네트워크 보안 및 트래픽
                보호
              </li>
            </ul>
          </section>

          <section class="space-y-2 border-t border-gray-100 pt-6">
            <h3 class="text-base font-bold text-gray-900">
              제6조 (개인정보의 파기 절차 및 방법)
            </h3>
            <ul class="list-disc space-y-1 pl-5 text-gray-600">
              <li>
                <strong>파기 절차:</strong> 이용자가 앱을 삭제하거나 단말기 설정에서
                앱 데이터를 초기화하는 경우, 단말기 내부 저장소(AsyncStorage)에 저장된
                모든 데이터는 즉시 물리적으로 파기됩니다.
              </li>
              <li>
                <strong>파기 방법:</strong> 단말기 내부 저장소의 전자적 파일은 재생할
                수 없는 기술적 방법을 사용하여 즉시 영구 삭제됩니다.
              </li>
            </ul>
          </section>

          <section class="space-y-2 border-t border-gray-100 pt-6">
            <h3 class="text-base font-bold text-gray-900">
              제7조 (정보주체와 법정대리인의 권리·의무 및 행사방법)
            </h3>
            <ol class="list-decimal space-y-1 pl-5 text-gray-600">
              <li>
                정보주체는 언제든지 단말기 내 앱 삭제를 통해 로컬에 저장된 관심
                상품 데이터와 설정값을 직접 파기할 수 있습니다.
              </li>
              <li>
                정보주체는 개인정보 보호책임자에게 이메일을 통해 개인정보 관련
                문의 및 열람, 정정, 삭제, 처리정지 등을 요청할 수 있습니다.
              </li>
              <li>
                단, 앱은 별도의 회원가입 계정이나 서버 데이터베이스 상의 개인
                식별정보를 보유하지 않으므로 별도의 서버 회원 탈퇴 절차가
                수반되지 않습니다.
              </li>
            </ol>
          </section>

          <section class="space-y-2 border-t border-gray-100 pt-6">
            <h3 class="text-base font-bold text-gray-900">
              제8조 (개인정보의 안전성 확보 조치)
            </h3>
            <p>
              운영자는 「개인정보 보호법」 제29조에 따라 서비스의 안전성 확보를
              위해 다음과 같은 조치를 취하고 있습니다.
            </p>
            <ul class="list-disc space-y-1 pl-5 text-gray-600">
              <li>
                <strong>전송 구간 암호화:</strong> API 서버 통신 시 보안 프로토콜(HTTPS
                / SSL / TLS)을 기본 적용하여 데이터 통신을 보호합니다.
              </li>
              <li>
                <strong>API 접근 보안:</strong> 비인가된 외부 호출을 방지하기 위해
                클라이언트-서버 간 인증 키 검증 메커니즘을 적용하고 있습니다.
              </li>
              <li>
